# Local Docker demo. Demo authorization is never enabled by production defaults.
DEMO_AUTH=true

# Set this manually in your shell or an untracked .env. Never commit a real token.
MAX_BOT_TOKEN=

PUBLIC_APP_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:8080
# Number of trusted reverse-proxy hops. Use 0 for direct local API access.
TRUST_PROXY_HOPS=1

# Optional local OpenAI-compatible runtime. mock is the safe default.
AI_PROVIDER=mock
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
